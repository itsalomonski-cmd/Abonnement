# Environment variables read by this project (placeholders only).
# The site needs NO secrets: no API keys, tokens or passwords.
# Copy to .env.local only if you need one of the switches below locally.

# SITE_ENV
# Set to "staging" for any NON-production deployment that is not on Vercel
# (for example a test server). It must be present when `next build` runs: the
# build then sends "X-Robots-Tag: noindex, nofollow" on every URL.
# Leave it UNSET for the production build.
# SITE_ENV=staging

# VERCEL_ENV
# Set automatically by Vercel ("production", "preview" or "development").
# Preview and development deployments are noindexed automatically.
# Never set it by hand.

# DISABLE_HMR
# Development only (inherited from the AI Studio template): "true" disables
# file watching in `next dev`. Has no effect on production builds.
# DISABLE_HMR=true
